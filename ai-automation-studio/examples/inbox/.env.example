# Секреты клиента пакета inbox. Скопируйте в clients/<id>/.env и заполните.
# Файл .env не попадает в git (см. .gitignore).

# --- Почтовый ящик (IMAP) ---
# Логин — полный адрес ящика. Пароль — ПАРОЛЬ ПРИЛОЖЕНИЯ (Gmail: myaccount.google.com/apppasswords,
# Яндекс: id.yandex.ru → Безопасность → Пароли приложений), а не основной пароль.
INBOX_IMAP_USER=info@demotours.example
INBOX_IMAP_PASSWORD=

# --- Модель ---
# openai | anthropic | fake (заглушка на ключевых словах, без сети)
AUTOSTUDIO_LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AUTOSTUDIO_LLM_MODEL=gpt-5.4-mini
# AUTOSTUDIO_LLM_EFFORT=low

# --- Уведомления владельцу о горячих лидах (если в конфиге задан notify.telegram_chat_id) ---
AUTOSTUDIO_NOTIFY_BOT_TOKEN=

# --- Google Sheets (если sink.backend = "google") ---
# Путь к JSON-ключу сервисного аккаунта; таблицей нужно поделиться с его e-mail (Редактор).
# GOOGLE_APPLICATION_CREDENTIALS=/srv/autostudio/clients/demo-inbox/service-account.json

# --- Оператор (вы): сигналы о сбоях и подозрительных письмах, пинги «жив» ---
AUTOSTUDIO_OPERATOR_BOT_TOKEN=
AUTOSTUDIO_OPERATOR_CHAT_ID=
AUTOSTUDIO_HEALTHCHECK_URL=
AUTOSTUDIO_DATA_DIR=var
