# Секреты клиента пакета inbox. `autostudio new-client` копирует этот файл в clients/<id>/.env.
# Файл .env не попадает в git (см. .gitignore); храните копию в менеджере паролей.
#
# Значения ниже рассчитаны на Docker (deploy/compose.client.yaml): каталог клиента смонтирован
# в /config, данные — в томе /data. Для запуска без Docker загружайте файл явно:
#   uv run --env-file clients/<id>/.env autostudio inbox check clients/<id>/inbox.toml
# и поменяйте AUTOSTUDIO_DATA_DIR и путь к ключу Google на локальные.

# --- Почтовый ящик (IMAP) ---
# Логин — полный адрес ящика. Пароль — ПАРОЛЬ ПРИЛОЖЕНИЯ (Gmail: myaccount.google.com/apppasswords,
# Яндекс: id.yandex.ru → Безопасность → Пароли приложений), а не основной пароль.
INBOX_IMAP_USER=info@demotours.example
INBOX_IMAP_PASSWORD=

# --- Модель ---
# openai | anthropic. Без провайдера `inbox run` не запустится (fake — только для проверки
# развёртывания: письма сортируются по ключевым словам, это не продукт).
AUTOSTUDIO_LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AUTOSTUDIO_LLM_MODEL=gpt-5.4-mini
# AUTOSTUDIO_LLM_EFFORT=low

# --- Сигналы владельцу о горячих лидах (если в конфиге задан notify.telegram_chat_id) ---
# Бот-уведомитель: @BotFather → /newbot → токен. Владелец пишет боту /start, chat_id — через
# @userinfobot (см. docs/packages/inbox.md).
AUTOSTUDIO_NOTIFY_BOT_TOKEN=

# --- Google Sheets (если sink.backend = "google") ---
# Путь к JSON-ключу сервисного аккаунта; таблицей нужно поделиться с его e-mail (Редактор).
# В Docker ключ лежит в каталоге клиента, смонтированном в /config.
# GOOGLE_APPLICATION_CREDENTIALS=/config/service-account.json

# --- Оператор (вы): сигналы о сбоях и подозрительных письмах, пинги «жив» ---
AUTOSTUDIO_OPERATOR_BOT_TOKEN=
AUTOSTUDIO_OPERATOR_CHAT_ID=
AUTOSTUDIO_HEALTHCHECK_URL=

# Где лежат состояние разбора и журнал событий: в контейнере — том /data (переживает
# пересоздание контейнера). Не меняйте на относительный путь: /app в образе только для чтения,
# а потерянное состояние значит повторные черновики и сигналы по старым письмам.
AUTOSTUDIO_DATA_DIR=/data
