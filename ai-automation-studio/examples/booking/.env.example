# Секреты развёртывания пакета booking. Скопируйте в clients/<id>/.env и заполните.
# Файл .env не попадает в git (см. .gitignore); храните копию в менеджере паролей.

# Токен бота записи: @BotFather → /newbot → скопировать токен вида 123456789:AA...
BOOKING_BOT_TOKEN=

# Отдельный бот для [notify] telegram_chat_id — нужен, только если уведомления владельцу
# идут не через бота записи (обычно не нужен: владелец в admin_chat_ids).
AUTOSTUDIO_NOTIFY_BOT_TOKEN=

# Модель для свободного текста и ответов на вопросы: openai | anthropic | fake.
# fake — без ключа и без сети: работают кнопки и простые правила (для демо и тарифа Basic).
AUTOSTUDIO_LLM_PROVIDER=openai
# Переопределение модели (по умолчанию gpt-5.4-mini для OpenAI); effort: low | medium | high.
AUTOSTUDIO_LLM_MODEL=
AUTOSTUDIO_LLM_EFFORT=low
# Ключ выбранного провайдера (второй можно оставить пустым).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Sheets ([sink] backend = "google"): путь к JSON-ключу сервисного аккаунта.
# Таблицу клиента нужно «Поделиться» с e-mail этого аккаунта (права «Редактор»).
GOOGLE_APPLICATION_CREDENTIALS=/config/service-account.json

# Где лежат SQLite записей и журнал событий (в контейнере — том /data).
AUTOSTUDIO_DATA_DIR=/data

# Пинг «жив» раз в час (healthchecks.io): период 1 ч, допуск 15 мин.
AUTOSTUDIO_HEALTHCHECK_URL=

# Сигналы оператору о сбоях: ваш личный чат и ваш служебный бот.
AUTOSTUDIO_OPERATOR_CHAT_ID=
AUTOSTUDIO_OPERATOR_BOT_TOKEN=
