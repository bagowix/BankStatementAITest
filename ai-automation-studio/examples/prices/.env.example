# Окружение монитора цен одного клиента. Скопируйте в clients/<id>/.env и заполните.
# Секреты живут только здесь (файл в .gitignore); в TOML-конфиге — лишь имена переменных.

# Модель для платной ступени (prices.llm_fallback = true).
# fake — эвристика без ИИ и без затрат; openai/anthropic — нужен ключ ниже.
AUTOSTUDIO_LLM_PROVIDER=fake
# AUTOSTUDIO_LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Где лежат SQLite-файлы клиента (история цен, журнал событий для месячного отчёта).
AUTOSTUDIO_DATA_DIR=var

# Google Sheets: путь к JSON-ключу сервисного аккаунта. Клиент делится таблицей
# с e-mail этого аккаунта (права «Редактор»). Нужен, если sink.backend = "google".
GOOGLE_APPLICATION_CREDENTIALS=/etc/autostudio/keys/service-account.json

# Уведомления владельцу в Telegram: токен бота от @BotFather (chat_id — в [notify] конфига).
AUTOSTUDIO_NOTIFY_BOT_TOKEN=

# Канал оператора (ваш): сбои ссылок, сломанные селекторы, исчерпанный бюджет модели.
AUTOSTUDIO_OPERATOR_BOT_TOKEN=
AUTOSTUDIO_OPERATOR_CHAT_ID=

# healthchecks.io (или аналог): пинг после каждого прохода; тишина — значит, сервер лёг.
AUTOSTUDIO_HEALTHCHECK_URL=

# Для `autostudio prices probe <url>` без --config: адрес, который уйдёт в User-Agent.
AUTOSTUDIO_PRICES_CONTACT_EMAIL=
